# Tanim.ai — Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=5001

# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/tanim_german

# Ollama configuration
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_MODEL=mistral-nemo:12b

# CORS allowed origins (use * to allow all, or comma-separated list)
OLLAMA_ORIGINS=*
