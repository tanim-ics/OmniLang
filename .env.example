# OmniLang — Environment Configuration
# ./start.sh creates .env from this file on first launch.

# Server
PORT=5001

# MongoDB connection URI (Docker mode overrides this to the mongo container)
MONGO_URI=mongodb://127.0.0.1:27017/tanim_german

# Ollama — runs natively on macOS so the model uses the Apple GPU (Metal)
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_MODEL=mistral-nemo:12b
# How long the model stays loaded after the last request (24h pins ~9 GB of memory)
OLLAMA_KEEP_ALIVE=1h
# Context window per request; 4096 fits every OmniLang prompt
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_MS=120000
# Set to 1 to log model latency per call
# OLLAMA_DEBUG=1

# CORS allowed origins (use * to allow all, or comma-separated list)
OLLAMA_ORIGINS=*

# Local timezone for streaks and daily quests (start.sh fills this in)
# TZ=Europe/Vienna
