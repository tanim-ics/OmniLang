{
  "name": "omnilang",
  "version": "1.0.0",
  "description": "Local-first CEFR-aligned German learning platform with AI speaking immersion",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "launch": "bash start.sh",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "setup": "bash setup.sh",
    "doctor": "node scripts/setup.js",
    "admin": "node scripts/admin.mjs",
    "test": "node tests/test_forgot_admin.mjs && node tests/test_admin_platform.mjs",
    "docker:check": "node scripts/docker-preflight.js",
    "docker:up": "node scripts/docker-preflight.js && docker compose up -d",
    "docker:down": "docker compose down",
    "reseed-bank": "node scripts/reseed-bank.mjs",
    "audit-bank": "python3 scripts/audit_vocab_bank.py",
    "stop": "bash start.sh --stop",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "nodemon": "^3.1.4",
    "postject": "^1.0.0-alpha.6"
  }
}
